# ToolLoom developer configuration template.
# Copy to `.env` and fill in only what you need. NEVER commit a real key.

# --- Agent provider selection -------------------------------------------------
# `commandcode` calls the real Command Code Provider API (BUILD_SPEC.md §4).
# `fake` is an offline deterministic provider used by the test suite only.
LLM_PROVIDER=commandcode

# --- Command Code Provider API (server-side only) -----------------------------
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
# openai | anthropic | auto
COMMANDCODE_API_STYLE=openai
# When 1, send `x-cmd-zdr: 1`; fail closed if the provider rejects it.
COMMANDCODE_ZDR=0

# --- Model budgeting (selected model's provider-reported context limit) --------
# Response reserve; capped to one quarter of the effective context window.
MODEL_MAX_OUTPUT_TOKENS=4096
# Optional smaller local cap; cannot raise a known provider limit. Blank = auto.
# If metadata is unavailable, a clearly labeled 32,768-token local budget is used.
MODEL_CONTEXT_WINDOW=
# One short additional model call after the first successful reply (max 1024 output
# tokens including reasoning, 30-second deadline). Failed titles can retry on later
# replies: 60-second cooldown, max 3 attempts. Set 0 to retain provisional titles.
TOOLLOOM_AUTO_TITLES=1

# --- Agent loop ceilings ------------------------------------------------------
TOOLLOOM_MAX_ITERATIONS=12
TOOLLOOM_MAX_TOOL_CALLS=40
TOOLLOOM_MAX_PARALLEL_TOOLS=4
TOOLLOOM_MAX_PAYLOAD_BYTES=200000
TOOLLOOM_RUN_TIMEOUT_SECONDS=300

# --- Server bind (local only) -------------------------------------------------
TOOLLOOM_HOST=127.0.0.1
TOOLLOOM_PORT=8000

# --- Local data (SQLite, vault key, workspaces). Git-ignored. -----------------
# TOOLLOOM_DATA_DIR=.local

# --- Secrets vault Fernet key (optional override; auto-generated if absent) ---
# TOOLLOOM_SECRETS_KEY=

# --- Optional: operator-managed stdio MCP servers (off by default) ------------
# When 1, you may register stdio servers with a fixed executable + arguments.
# The model can never create stdio commands.
TOOLLOOM_ALLOW_STDIO=0

# --- Optional: model-requested Python (off by default; NOT OS-isolated) --------
# Runs as your user: code can access host files/network. Only opt in for trusted
# use. Then enable AND approve sandbox → python in Settings → MCP.
# Uses the backend's Python interpreter and installed packages; no shell.
TOOLLOOM_ALLOW_PYTHON=0
TOOLLOOM_PYTHON_TIMEOUT_SECONDS=15
TOOLLOOM_PYTHON_OUTPUT_BYTES=64000

# --- Optional: token pricing for a cost estimate (never invented) -------------
# Applied only if set; leave blank to report tokens without a cost.
# TOOLLOOM_PRICE_INPUT_PER_1K=
# TOOLLOOM_PRICE_OUTPUT_PER_1K=

# --- Test/load-harness fixture (off by default) -------------------------------
# Seeds the synthetic `demo` local server (demo__add). A normal installation
# ships only `sandbox`; the pytest suite and the load/browser harnesses set this
# themselves and do not read this value.
TOOLLOOM_SEED_DEMO=0

# --- Keyless web search (sandbox__web_search) ---------------------------------
# No provider needs an API key. `duckduckgo` (default) reads the public HTML
# endpoint; `wikipedia` uses the MediaWiki search API; `searxng` needs an
# operator-run instance with the `json` output format enabled.
# The tool is high-risk and ships disabled: enable AND approve it under
# Settings -> MCP -> sandbox before the model may use it. Only the query text
# is sent; no credentials, files or conversation history leave the machine.
TOOLLOOM_SEARCH_PROVIDER=duckduckgo
# TOOLLOOM_SEARCH_URL=http://127.0.0.1:8080
TOOLLOOM_SEARCH_MAX_RESULTS=5
TOOLLOOM_SEARCH_TIMEOUT_SECONDS=15
